LAYA_ADMIN_KEY=replace-with-at-least-24-random-characters
LAYA_API_KEY_PEPPER=replace-with-at-least-32-random-characters
LAYA_DATABASE_PATH=data/laya-service.db
LAYA_MODEL_ID=aac6fef/laya-mlx
LAYA_MODEL_DTYPE=float16
LAYA_ENABLED_MODELS=laya,laya-omni
LAYA_DEFAULT_MODEL=laya
LAYA_OMNI_KIT_PATH=../laya-omni-kit
# Use the omni environment when laya-omni is enabled (absolute path for launchd).
LAYA_SERVICE_VENV=/absolute/path/to/laya-omni-kit/.venv
LAYA_MAX_UPLOAD_MB=50
LAYA_EAGER_LOAD_MODEL=true
LAYA_STORE_PAYLOADS=true
LAYA_TRUST_PROXY_HEADERS=false
